# Required environment variables — copy this file to .env and fill in values.
# Never commit .env or real credentials to the repository.
# See docs/plans/week-01-proposed-implementation.md §16 for full description.

# ── Application ──────────────────────────────────────────────────────────────
# Environment: development | test | production
APP_ENV=development

# Human-readable label used in logs and health responses
APP_LABEL=whatsapp-business-platform

# API route prefix
API_PREFIX=/api/v1

# Comma-separated list of allowed browser origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ── Database (application runtime role) ──────────────────────────────────────
# Used by the FastAPI application at runtime. This role must NOT be a superuser,
# must NOT have BYPASSRLS, and must NOT own any tables.
DATABASE_URL=postgresql+psycopg://app_runtime:CHANGEME_RUNTIME_PASSWORD@db:5432/wbp_dev

# ── Database (migration owner role) ──────────────────────────────────────────
# Used ONLY by Alembic migrations. The application never reads this variable.
# Keep this credential separate from the runtime credential.
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:CHANGEME_MIGRATION_PASSWORD@db:5432/wbp_dev

# ── PostgreSQL container credentials (used by compose.yaml) ──────────────────
POSTGRES_DB=wbp_dev
POSTGRES_MIGRATION_USER=migration_owner
POSTGRES_MIGRATION_PASSWORD=CHANGEME_MIGRATION_PASSWORD
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=CHANGEME_RUNTIME_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Session settings ──────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=session
# Idle timeout in minutes (default: 30)
SESSION_IDLE_MINUTES=30
# Absolute session lifetime in hours (default: 12)
SESSION_ABSOLUTE_HOURS=12
# Secret used to sign/verify session values — must be at least 32 random bytes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=CHANGEME_at_least_32_random_bytes_here

# ── Login throttling ──────────────────────────────────────────────────────────
# Maximum failed login attempts per email per window before 429
THROTTLE_MAX_EMAIL_ATTEMPTS=5
# Maximum failed login attempts per IP per window before 429
THROTTLE_MAX_IP_ATTEMPTS=20
# Rolling window in minutes
THROTTLE_WINDOW_MINUTES=15
# Secret used to HMAC-pseudonymise email/IP keys stored in Redis
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
THROTTLE_PSEUDONYM_SECRET=CHANGEME_separate_throttle_secret_here

# ── Test database (separate from development database) ────────────────────────
# Tests MUST use this database. Commands refuse to run against a non-test target.
TEST_DATABASE_URL=postgresql+psycopg://app_runtime:CHANGEME_RUNTIME_PASSWORD@db:5432/wbp_test
TEST_POSTGRES_DB=wbp_test

# ── Not required in Week 1 ────────────────────────────────────────────────────
# OPENAI_API_KEY=    (added in Week 6)
# META_APP_SECRET=   (added in Week 2)
# META_VERIFY_TOKEN= (added in Week 2)
